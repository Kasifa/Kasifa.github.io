    "equalCarrierMValuesRule": "2^j for 0<=j<=20",
    "finiteIntegrator": "DOP853",
    "rtol": 2e-11,
    "atol": 2e-13,
    "matrixRadius": 24,
    "multipliers": [1, 2, 4, 7],
    "coefficients": [0.8, 0.55, 0.35, 0.2],
    "besselRValues": [8, 16, 32, 64, 128, 256, 512, 1024]
  },
  "besselNoGo": {
    "deltaRule": "R^4",
    "rootNeighborhood": 0.35,
    "frozenEnhancedDissipationRate": "R^2/(log R)^2",
    "Theta": "L_R*Gamma_fr,R",
    "Xi": "2*R^4*[L_R-(1-exp(-L_R))]",
    "energyLossUpper": "[4*T_R+4*T_R^2+(8/3)*T_R^3]/R^4"
  },
  "randomness": false,
  "intervalArithmetic": false
}
