      "lateDiagonal": "b_lambda=2 C_S V_tau sqrt(pi/lambda)",
      "majorant": "L=[[a,0],[a,b_lambda]]",
      "normEquivalence": "Gamma=1+sqrt(27)+exp(lambda(T-tau))(sqrt(T/tau)+r_T/sqrt(tau))",
      "resolventBound": "M_v(T)<=Gamma/((1-a)(1-b_lambda))"
    },
    "hypotheses": [
      "a=2 C_B ||v||_Xtau < 1",
      "V_tau=sup_[tau,T] ||v(t)||_infinity < infinity",
      "b_lambda=2 C_S V_tau sqrt(pi/lambda) < 1"
    ],
    "smoothReferenceCorollary": "||v||_Xtau<=2 sqrt(tau)||v||_infinity, so every smooth reference on a compact regular interval satisfies the gates"
