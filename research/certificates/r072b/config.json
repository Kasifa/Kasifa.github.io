    "equalCarrierPower": "-10/3",
    "comparableAmplitudeEnvelope": "0<c_minus*a<=z_l<=c_plus*a with one sign gives chi<=0.5*(c_plus/c_minus)^2/M and Omega^2/Kv<=12*Kz^2*(c_plus/c_minus)^2/M",
    "phaseBoundary": "alpha<min(5/2,(10+3*beta)/7)"
  },
  "producer": {
