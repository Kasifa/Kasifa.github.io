{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasifa.github.io/contracts/publication-visual-qa.schema.json",
  "title": "Publication visual QA evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "publicationCommit",
    "inspectedAt",
    "checks",
    "defects"
  ],
  "properties": {
    "schemaVersion": { "const": "publication-visual-qa-v1" },
    "releaseId": { "type": "string", "pattern": "^r0[0-9]{2}[a-z]$" },
    "publicationCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "inspectedAt": { "type": "string", "format": "date-time" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "status", "method"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "const": "pass" },
          "method": { "type": "string", "minLength": 1 }
        }
      }
    },
    "defects": {
      "type": "array",
      "maxItems": 0
    }
  }
}
