{
  "schemaVersion": "r072c-certificate-config-v1",
  "analyticModel": {
    "physicalPairing": "-i*Kz*[w_l*T_(r_l)+conj(w_l)*T_(-r_l)]",
    "rhoSquared": "2*Kz^2*sum_l |w_l|^2*exp(-2*kappa*r_l^2*A0)",
    "chi": "rho_A^2/Omega_A^2",
    "jointInequality": "chi*(Omega_A^2/Kv)^(1/3)<=(rho_A^2/Kv)^(1/3)",
    "heatSum": "H_M(A0)=sum_(j=1)^M exp(-2*kappa*A0*j^2)",
    "uniformPrefactor": "Phi_A,M<=C*M^-3*H_M(A0)^(1/3)",
    "exactLaunchPower": "-8/3",
    "fixedPositivePower": "-3",
    "coherentComparisonPower": "-10/3",
    "exactLaunchBoundary": "alpha<min(2,(8+3*beta)/7)",
    "fixedPositiveBoundary": "alpha<min(9/4,(9+3*beta)/7)"
  },
  "producer": {
    "engine": "mpmath",
    "decimalDigits": 90,
    "heatMValuesRule": "2^j for 5<=j<=12",
    "rudinShapiroGenerations": "0<=n<=13",
    "oddSharpnessGenerations": "n in {1,3,5,7,9,11,13}",
    "fixedPositiveT": 0.01
  },
  "independent": {
    "engine": "NumPy/SciPy binary64",
    "importsProducer": false,
    "readsProducerResult": false,
    "finiteMatrixCheck": true,
    "directTrigonometricCheck": true,
    "fixedPositiveT": 0.01
  },
  "randomness": false,
  "intervalArithmetic": false
}
